generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  password       String
  role           Role            @default(USER)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  
  // Relations
  projectMembers ProjectMember[]
  assignedTasks  Task[]

  @@map("users")
}

model Project {
  id        String          @id @default(uuid())
  name      String
  createdAt DateTime        @default(now())
  
  // Relations
  members   ProjectMember[]
  tasks     Task[]

  @@map("projects")
}

// Junction table for Many-to-Many relationship between Users and Projects
model ProjectMember {
  userId    String
  projectId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId]) // Composite primary key
  @@map("project_members")
}

model Task {
  id          String     @id @default(uuid())
  name        String
  status      TaskStatus @default(PENDING)
  order       String     // Lexicographical string for O(1) drag-and-drop reordering
  priority    String?    @default("MEDIUM")
  dueDate     DateTime?
  createdAt   DateTime   @default(now())
  
  projectId   String
  assigneeId  String?    // Nullable, as a task might not be assigned immediately

  // Relations
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee    User?      @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  @@map("tasks")
}